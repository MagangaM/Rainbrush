# Copy to .env and fill in. Restart the app after any change.

# ─── SMS ──────────────────────────────────────────────────────
# SMS_PROVIDER: 'africastalking' or 'twilio'
SMS_PROVIDER=africastalking

# 1 = log messages to disk instead of sending. Keep ON until tested.
SMS_DRY_RUN=1

# Throttle. Increase once you know your carrier limits.
SMS_MAX_PER_SECOND=5

# ─── AFRICA'S TALKING (recommended for East/West Africa) ──────
# Get credentials at https://africastalking.com
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=RAINBRUSH
AT_ENQUEUE=1

# ─── TWILIO (global coverage, higher cost in Africa) ──────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ─── VOICE ────────────────────────────────────────────────────
# Buy a virtual number in the AT dashboard (Voice > Phone Numbers).
AT_CALLER_ID=
VOICE_MAX_PER_SECOND=2

# ─── SCHEDULER ────────────────────────────────────────────────
SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_HOURS=6
SCHEDULER_AUTO_SEND=0

# 1 = allow the scheduler to send to demo farmers. NEVER in production.
ALLOW_SEED_SEND=0

# ─── RECEIPTS ─────────────────────────────────────────────────
RECEIPTS_POLL_INTERVAL_MS=60000

# ─── USSD RELAY ───────────────────────────────────────────────
# Public URL of the deployed relay. Leave blank to disable.
USSD_RELAY_URL=
USSD_RELAY_SECRET=