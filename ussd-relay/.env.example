# Shared secret between this relay and the desktop app.
# Generate with: openssl rand -hex 32
RELAY_SECRET=

# Server port (Fly.io sets this automatically in production)
PORT=8080

# SQLite file path. On Fly.io this should be under the mounted volume.
DB_PATH=./relay.db

# How often to refresh forecasts from Open-Meteo.
# Default 3 hours = 10800000 ms.
REFRESH_INTERVAL_MS=10800000